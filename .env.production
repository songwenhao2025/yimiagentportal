# =====================================================
# 壹米AI Agent门户 - 生产环境配置
# =====================================================

# API 配置
VUE_APP_API_BASE_URL=https://api.yimi-ai.com/api
VUE_APP_API_TIMEOUT=30000

# 数据库配置
VUE_APP_DB_HOST=localhost
VUE_APP_DB_PORT=3306
VUE_APP_DB_NAME=yimi_ai_portal
VUE_APP_DB_USER=prod_user
VUE_APP_DB_PASSWORD=prod_password

# 日志配置
VUE_APP_LOG_LEVEL=info

# 其他配置
VUE_APP_VERSION=1.0.0
VUE_APP_ENV=production