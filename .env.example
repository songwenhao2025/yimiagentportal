# 壹米 AI Agent 门户 - 环境变量模板
# 复制本文件为 .env 并填入真实值后, 由启动脚本/容器/部署环境读取。
# 注: .env 已加入 .gitignore, 不会被提交。

# ============================================================
# 数据库 (所有 7 个后端服务必需)
# ============================================================
DB_URL=jdbc:mysql://localhost:3306/yimi_ai_portal?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=请填入真实数据库密码

# ============================================================
# JWT 鉴权 (所有服务共享同一个密钥, 必须至少 32 字节)
# 生成方式 (PowerShell):
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 48 | % {[char]$_})
# ============================================================
JWT_SECRET_KEY=请填入至少32字节的随机密钥-do-not-use-this-default
JWT_EXPIRATION=86400000

# ============================================================
# Anthropic Claude (仅 llm-service 需要)
# ============================================================
ANTHROPIC_API_KEY=any-key
ANTHROPIC_BASE_URL=http://localhost:15721
