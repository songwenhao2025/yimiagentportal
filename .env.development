# =====================================================
# 壹米AI Agent门户 - 开发环境配置
# =====================================================

# API 配置
# 留空：所有 /api/* 请求由 Vite dev server 代理（见 vite.config.ts）按前缀转发到对应微服务
VITE_API_BASE_URL=
VITE_API_TIMEOUT=120000

# 日志配置
VITE_LOG_LEVEL=debug

# 其他配置
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development
